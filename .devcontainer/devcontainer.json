{
  "name": "libwallaby Dev",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "dev"
  },
  "mounts": [
    "source=claude-config,target=/home/code/.claude,type=volume",
    "source=codex-config,target=/home/code/.codex,type=volume"
  ],
  // The agent CLIs' bubblewrap sandboxes need syscalls Docker's default
  // seccomp profile blocks, and must mount a fresh /proc, which Docker's
  // masked /proc paths prevent. These disable Docker's syscall filter and
  // /proc masking for this container.
  "runArgs": [
    "--security-opt=seccomp=unconfined",
    "--security-opt=systempaths=unconfined"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "github.vscode-pull-request-github"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "fish",
        "terminal.integrated.profiles.linux": {
          "fish": {
            "path": "/usr/bin/fish"
          }
        }
      }
    }
  }
}
